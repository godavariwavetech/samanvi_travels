# Staging SPA, served by Apache from public_html/staging/. Production has its
# own .htaccess at the public_html root; both deploy workflows exclude
# .htaccess from rsync, so neither file is ever overwritten by a deploy.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /staging/

  # Real files and directories (the hashed bundles under /staging/assets/) are
  # served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route (/staging/trips/expenses and the
  # like). Hand back index.html and let React Router resolve it, otherwise a
  # refresh or a pasted deep link is a 404 from Apache.
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html names the current build's hashed assets, so a cached copy keeps
  # requesting the previous build's filenames after a deploy and the page comes
  # up blank. The hashed assets themselves never change under a given name.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
